# ─────────────────────────────────────────────────────────────
# Capas derivadas: se regeneran con `make update`. Nunca versionar.
# ─────────────────────────────────────────────────────────────

# Origen bruto: clones sparse y tarballs descargados.
# Es lo único verdaderamente temporal: `make update` lo borra al acabar.
work/
work-*/

# Estructura antigua, sustituida por work/ + src/
repos/

# NOTA: src/ y public/ SÍ se versionan. Son los resultados del
# proyecto, no pasos intermedios. En git van los resultados más las
# herramientas para obtenerlos; lo que se descarga, no.

# Bundles concatenados para modelos de IA
dist/

# Descargas a medias
*.part
*.crdownload
*.download


# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ─────────────────────────────────────────────────────────────
# Sistema operativo
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.TemporaryItems
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Icon?
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~
.directory


# ─────────────────────────────────────────────────────────────
# Editores
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
*.sublime-workspace
*.swp
*.swo
.\#*
\#*\#
.netrwhist


# ─────────────────────────────────────────────────────────────
# Google Drive y otros sincronizadores
# ─────────────────────────────────────────────────────────────
.tmp.drivedownload/
.tmp.driveupload/
*.gdoc
*.gsheet
*.gslides
.dropbox
.dropbox.attr
desktop.ini


# ─────────────────────────────────────────────────────────────
# Temporales y copias manuales
# Para versionar está git; nada de ficheros "BACKUP".
# ─────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
*.rej
*.log
* BACKUP.*
*copia*
*.old


# ─────────────────────────────────────────────────────────────
# Lo que SÍ se versiona, por si alguna regla de arriba se pasa
# ─────────────────────────────────────────────────────────────
!src/**
!public/**
!scripts/**
!info/**
!sources.yaml
!versions.lock.json
!requirements.txt
!Makefile

# Exclusiones de archivos del sistema que nunca deben versionarse
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/Thumbs.db
**/desktop.ini
**/__pycache__/
**/*.py[cod]
